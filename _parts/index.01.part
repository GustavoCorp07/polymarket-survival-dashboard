ont-size: 10px; line-height: 1.35; }
  .agent .stat { margin-top: 10px; font-size: 11px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .ftr {
    display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center;
    color: var(--muted); font-size: 10px; letter-spacing: 0.06em; flex: 0 0 auto;
    padding-top: 2px; position: relative; min-width: 0;
  }
  .ftr .wm {
    position: absolute; left: 50%; transform: translateX(-50%);
    font-size: 42px; font-weight: 800; color: #0d0d0d; letter-spacing: 0.2em;
    pointer-events: none; z-index: 0;
  }
  .ftr .left { z-index: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ftr .right { text-align: right; z-index: 1; color: var(--dim); white-space: nowrap; font-variant-numeric: tabular-nums; }

  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }

  @media (max-width: 1100px) {
    .agents { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mid { grid-template-columns: minmax(0, 1fr); }
    .right-col .panel.log { min-height: 180px; }
  }
  @media (max-width: 700px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agents { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
</head>
<body>
  <div class="hdr">
    <div class="hdr-left">
      GROK BOT / SURVIVAL MODE
      <span class="pill boot" id="statusPill"><span class="dot"></span><span id="statusTxt">BOOT</span></span>
    </div>
    <div class="hdr-right">
      <span>UPTIME <span id="uptime">00:00:00</span></span>
      <span>·</span>
      <span>CYCLE #<span id="cycle">0</span></span>
      <span>·</span>
      <span>PID <span id="pid">—</span></span>
    </div>
  </div>

  <div class="cards">
    <div class="card">
      <div class="lbl">CURRENT BALANCE</div>
      <div class="val" id="balance">$50.00</div>
      <div class="sub" id="initial">initial: $50.00</div>
    </div>
    <div class="card">
      <div class="lbl">TOTAL P&amp;L</div>
      <div class="val" id="pnl">+$0.00</div>
      <div class="sub" id="pnlPct">+0.0%</div>
    </div>
    <div class="card">
      <div class="lbl">SUBSCRIPTION</div>
      <div class="val" id="sub">$0.00</div>
      <div class="sub" id="subDue">$200/mo · due</div>
    </div>
    <div class="card">
      <div class="lbl">WIN RATE</div>
      <div class="val" id="winRate">0.0%</div>
      <div class="sub" id="wl">0W / 0L</div>
    </div>
  </div>

  <div class="mid">
    <div class="panel">
      <div class="panel-h">
        <span>// BALANCE HISTORY (LOG SCALE)</span>
        <span class="r"><span id="hoursAlive">0.0</span>H / 48H</span>
      </div>
      <div class="chart-wrap">
        <div class="awaiting" id="awaiting">[ AWAITING FIRST CYCLE ]</div>
        <canvas id="balChart"></canvas>
      </div>
    </div>
    <div class="right-col">
      <div class="panel log">
        <div class="panel-h">
          <span>// ACTIVITY LOG</span>
          <span class="r"><span id="resolved">0</span> RESOLVED</span>
        </div>
        <div id="activity"></div>
      </div>
      <div class="panel space">
        <div class="panel-h">
          <span>// MARKET SPACE · LIVE SCAN</span>
          <span class="r"><span id="liveN">0</span> LIVE</span>
        </div>
        <div class="space-body"><canvas id="mktCanvas"></canvas></div>
        <div class="space-foot">
          <span>x LIQUIDITY &nbsp; y EDGE &nbsp; z BOOK</span>
          <span><span id="cryptoN">CRYPTO 0</span> &nbsp; <span id="weatherN">WEATHER 0</span> &nbsp; <span id="overN">0 OVER +8.0%</span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="strip">
    <div class="strip-h">
      <span>// SURVIVAL + LEDGER</span>
      <span>KILL AT $<span id="killAt">0.00</span> · <span id="cyc48">288</span> CYCLES / 48H</span>
    </div>
    <div class="strip-row">
      <div class="metric">
        <div class="ml">RUNWAY</div>
        <div class="mv" id="runway">0 days</div>
        <div class="runway-bar"><i id="runwayBar" style="width:0%"></i></div>
      </div>
      <div class="metric"><div class="ml">DAILY COST</div><div class="mv red" id="dailyCost">-$6.58</div></div>
      <div class="metric"><div class="ml">TRADES</div><div class="mv" id="trades">0</div></div>
      <div class="metric"><div class="ml">SCANNED</div><div class="mv" id="scanned">0</div></div>
      <div class="metric"><div class="ml">AVG BET</div><div class="mv" id="avgBet">$0.00</div></div>
      <div class="metric"><div class="ml">AVG EDGE</div><div class="mv" id="avgEdge">0.0%</div></div>
      <div class="metric"><div class="ml">BEST</div><div class="mv green" id="best">+$0.00</div></div>
      <div class="metric"><div class="ml">WORST</div><div class="mv" id="worst">+$0.00</div></div>
    </div>
  </div>

  <div class="agents" id="agents"></div>

  <div class="ftr">
    <div class="left" id="footerLeft">GROK BOT · POLYMARKET · PAPER · AUTONOMOUS · KIMI K3</div>
    <div class="wm">ARGONA</div>
    <div class="right">NEXT CYCLE <span id="nextCycle">10:00</span></div>
  </div>

<script>
const $ = (id) => document.getElementById(id);

let lastState = null;
let rot = 0.35;
let pollBusy = false;
let activityFp = '';
let agentsFp = '';
let balanceFp = '';
let baseUptimeSec = 0;
let baseUptimeAt = performance.now();
let nextCycleTs = null;
let userPinnedLog = false;

function fmtMoney(n, sign=false) {
  const v = Number(n)||0;
  const abs = Math.abs(v).toFixed(2);
  if (sign) return (v>=0? '+':'−') + '$' + abs;
  return '$' + abs;
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function setText(id, text) {
  const el = $(id);
  if (!el) return;
  const t = String(text);
  if (el.textContent !== t) el.textContent = t;
}
function setStatus(s) {
  const pill = $('statusPill');
  const cls = 'pill ' + (s||'BOOT').toLowerCase();
  if (pill.className !== cls) pill.className = cls;
  setText('statusTxt', s || 'BOOT');
}
function fmtUptime(sec) {
  sec = Math.max(0, Math.floor(sec));
  const h = Math.floor(sec/3600), m = Math.floor((sec%3600)/60), s = sec%60;
  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
}

function iconSvg(kind, color) {
  const eyes = `<rect x="10" y="11" width="2.2" height="8" rx="1" fill="#000"/><rect x="15.8" y="11" width="2.2" height="8" rx="1" fill="#000"/>`;
  if (kind==='cloud') return `<svg width="28" height="28" viewBox="0 0 28 28"><ellipse cx="14" cy="15" rx="12" ry="9" fill="${color}"/>${eyes}</svg>`;
  if (kind==='circle') return `<svg width="28" height="28" viewBox="0 0 28 28"><circle cx="14" cy="14" r="11" fill="${color}"/>${eyes}</svg>`;
  if (kind==='drop') return `<svg width="28" height="28" viewBox="0 0 28 28"><path d="M14 2 C14 2 24 14 24 18 A10 10 0 0 1 4 18 C4 14 14 2 14