in-height: 0; min-width: 0; overflow: hidden; }
  #mktCanvas { width: 100%; height: 100%; display: block; }
  .space-foot {
    display: flex; justify-content: space-between; gap: 8px; padding: 4px 12px 8px;
    color: var(--muted); font-size: 10px; letter-spacing: 0.04em; flex: 0 0 auto;
    min-width: 0;
  }
  .space-foot span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .strip {
    border: 1px solid var(--border2); background: var(--panel);
    padding: 8px 12px; flex: 0 0 auto; min-width: 0;
  }
  .strip-h {
    display: flex; justify-content: space-between; color: var(--muted);
    font-size: 10px; letter-spacing: 0.06em; margin-bottom: 8px; gap: 8px;
  }
  .strip-row {
    display: flex; flex-wrap: wrap; gap: 18px 22px; align-items: flex-end;
  }
  .metric .ml { color: var(--muted); font-size: 9px; letter-spacing: 0.08em; margin-bottom: 2px; }
  .metric .mv { color: var(--white); font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .metric .mv.red { color: var(--red); }
  .metric .mv.green { color: var(--green); }
  .runway-bar {
    height: 3px; width: 56px; background: #1a1a1a; margin-top: 4px; border-radius: 1px;
  }
  .runway-bar > i { display: block; height: 100%; background: var(--green); border-radius: 1px; transition: width .25s ease; }

  .agents {
    display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; flex: 0 0 auto;
  }
  .agent {
    border: 1px solid var(--border2); background: var(--panel);
    padding: 10px 10px 12px; position: relative; min-height: 108px; min-width: 0; overflow: hidden;
  }
  .agent .num { position: absolute; top: 8px; right: 10px; color: #333; font-size: 10px; }
  .agent .ico { width: 28px; height: 28px; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; }
  .agent .name { font-weight: 700; color: var(--white); font-size: 12px; margin-bottom: 4px; letter-spacing: 0.04em; }
  .agent .owns { color: var(--muted); font-size: 10px; line-height: 1.35; }
  .agent .stat { margin-top: 10px; font-size: 11px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .ftr {
    display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center;
    color: var(--muted); font-size: 10px; letter-spacing: 0.06em; flex: 0 0 auto;
    padding-top: 2px; position: relative; min-width: 0;
  }
  .ftr .wm {
    position: absolute; left: 50%; transform: translateX(-50%);
    font-size: 42px; font-weight: 800; color: #0d0d0d; letter-spacing: 0.2em;
    pointer-events: none; z-index: 0;
  }
  .ftr .left { z-index: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ftr .right { text-align: right; z-index: 1; color: var(--dim); white-space: nowrap; font-variant-numeric: tabular-nums; }

  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }

  @media (max-width: 1100px) {
    .agents { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mid { grid-template-columns: minmax(0, 1fr); }
    .right-col .panel.log { min-height: 180px; }
  }
  @media (max-width: 700px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .agents { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
</head>
<body>
  <div class="hdr">
    <div class="hdr-left">
      GROK BOT / SURVIVAL MODE
      <span class="pill boot" id="statusPill"><span class="dot"></span><span id="statusTxt">BOOT</span></span>
    </div>
    <div class="hdr-right">
      <span>UPTIME <span id="uptime">00:00:00</span></span>
      <span>·</span>
      <span>CYCLE #<span id="cycle">0</span></span>
      <span>·</span>
      <span>PID <span id="pid">—</span></span>
    </div>
  </div>

  <div class="cards">
    <div class="card">
      <div class="lbl">CURRENT BALANCE</div>
      <div class="val" id="balance">$50.00</div>
      <div class="sub" id="initial">initial: $50.00</div>
    </div>
    <div class="card">
      <div class="lbl">TOTAL P&amp;L</div>
      <div class="val" id="pnl">+$0.00</div>
      <div class="sub" id="pnlPct">+0.0%</div>
    </div>
    <div class="card">
      <div class="lbl">SUBSCRIPTION</div>
      <div class="val" id="sub">$0.00</div>
      <div class="sub" id="subDue">$200/mo · due</div>
    </div>
    <div class="card">
      <div class="lbl">WIN RATE</div>
      <div class="val" id="winRate">0.0%</div>
      <div class="sub" id="wl">0W / 0L</div>
    </div>
  </div>

  <div class="mid">
    <div class="panel">
      <div class="panel-h">
        <span>// BALANCE HISTORY (LOG SCALE)</span>
        <span class="r"><span id="hoursAlive">0.0</span>H / 48H</span>
      </div>
      <div class="chart-wrap">
        <div class="awaiting" id="awaiting">[ AWAITING FIRST CYCLE ]</div>
        <canvas id="balChart"></canvas>
      </div>
    </div>
    <div class="right-col">
      <div class="pa