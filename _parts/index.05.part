tate.balance_history||[]) + '|' + (state.pnl||0);
  if (bfp !== balanceFp) {
    balanceFp = bfp;
    drawBalance(state);
  }
  tickClocks();
}

async function poll() {
  if (pollBusy) return;
  pollBusy = true;
  try {
    const urls = ['/api/state?t=' + Date.now(), './state.json?t=' + Date.now()];
    let st = null, lastErr = null;
    for (const url of urls) {
      try {
        const r = await fetch(url, {cache:'no-store'});
        if (!r.ok) throw new Error(url + ' ' + r.status);
        st = await r.json();
        break;
      } catch (e) { lastErr = e; }
    }
    if (!st) throw lastErr || new Error('no state');
    render(st);
  } catch (e) {
    console.warn(e);
  } finally {
    pollBusy = false;
  }
}

function animate() {
  rot += 0.006;
  if (lastState) drawMarket(lastState);
  requestAnimationFrame(animate);
}

let resizeTimer = null;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(() => {
    if (!lastState) return;
    balanceFp = '';
    drawBalance(lastState);
    drawMarket(lastState);
  }, 80);
});

poll();
setInterval(poll, 1000);
setInterval(tickClocks, 250);
requestAnimationFrame(animate);
</script>
</body>
</html>
